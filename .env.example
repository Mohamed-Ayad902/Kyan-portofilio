# Public base URL used for canonical links, hreflang, sitemap and Open Graph.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Quote-request delivery (server-side only — never prefix these with NEXT_PUBLIC_).
# Preferred: the Google Apps Script in integrations/google-sheets, which saves each request to a
# Google Sheet and emails it to Kayan. Setup steps are in integrations/google-sheets/README.md.
QUOTE_SHEET_URL=
QUOTE_SHEET_SECRET=

# Alternative when the sheet variables are empty: email through Resend.
# When RESEND_API_KEY and QUOTE_TO_EMAIL are both set, quote requests are emailed via Resend.
# When they are missing, the form tells visitors that online sending is unavailable and offers
# email / WhatsApp / phone instead (it never pretends to have sent anything).
RESEND_API_KEY=
QUOTE_TO_EMAIL=kayanequipment@gmail.com
# A sender on a domain verified in Resend, e.g. "Kayan Website <quotes@yourdomain.com>"
QUOTE_FROM_EMAIL=
